[Unit]
Description=PowerScope HDMI current waveform and NPU diagnosis
Requires=powerscope-ps.service
After=powerscope-ps.service
Conflicts=getty@tty7.service display-manager.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=uisrc
Group=uisrc
SupplementaryGroups=video input tty
WorkingDirectory=/opt/powerscope-display/current
Environment=PYTHONNOUSERSITE=1
# systemd supplies tty7 as the controlling terminal. /dev/tty7 itself is
# root:tty 0620; /dev/tty opens our controlling terminal without changing it.
Environment=QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0:tty=/dev/tty
Environment=QT_SCALE_FACTOR=1.5
Environment=QT_AUTO_SCREEN_SCALE_FACTOR=0
Environment=QT_QPA_FB_HIDECURSOR=1
# This vendor udev image gives fb0 a seat tag, not a systemd device tag.
# Check the real character device instead of waiting for dev-fb0.device.
ExecStartPre=/usr/bin/test -c /dev/fb0
ExecStartPre=+/bin/chvt 7
ExecStart=/bin/sh /opt/powerscope-display/current/board/deploy/run_display.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
StandardInput=tty
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
UMask=0077

[Install]
WantedBy=multi-user.target
